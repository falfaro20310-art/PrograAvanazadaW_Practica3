@model List<Practica3_Grupo2.Models.CompraViewModel>
@{
    ViewData["Title"] = "Consulta de Productos";
}

<h2>Consulta de Productos</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    </div>
}

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Saldo</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var compra in Model)
            {
                <tr>
                    <td>@compra.CodigoCompra</td>
                    <td>@compra.Descripcion</td>
                    <td>@compra.Precio.ToString("C2")</td>
                    <td>@compra.Saldo.ToString("C2")</td>
                    <td>
                        @if (compra.Estado == "Pendiente")
                        {
                            <span class="badge bg-warning text-dark">@compra.Estado</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@compra.Estado</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay productos para mostrar.</p>
}
